<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent for Forge on macOS. A user agent, not a daemon: it runs in
  your login session, so keychains, Xcode, gh and claude logins are available.

    install -m755 forge ~/.local/bin/forge
    cp deploy/dev.forge.agent.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.forge.agent.plist
    launchctl kickstart -k gui/$(id -u)/dev.forge.agent     # restart
    tail -f /tmp/forge-agent.err.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.forge.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec "$HOME/.local/bin/forge" agent -config "$HOME/.config/forge/runner.json"</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/tmp/forge-agent.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/forge-agent.err.log</string>
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
