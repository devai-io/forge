# Forge server configuration (docker compose reads this file as .env).
# Copy to .env and fill in. Never commit .env.

# The address people open. Decides cookie security (https → Secure cookies),
# the only Origin allowed to make changes, and links in e-mails.
PUBLIC_URL=http://localhost:8080

# Postgres. docker-compose.yml starts one and builds this URL itself; set it
# only when you bring your own database.
# DATABASE_URL=postgres://forge:change-me@db:5432/forge?sslmode=disable
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Where the server keeps files it creates, e.g. the vault key (vault.key).
# BACK THIS UP: without vault.key the vault cannot be decrypted.
FORGE_DATA_DIR=/data
# Or provide the key yourself (base64, 32 bytes: openssl rand -base64 32):
# VAULT_KEY_FILE=/run/secrets/vault_key

# Timezone new accounts start in (changeable per account in Settings).
FORGE_TIMEZONE=UTC

# Load three example projects into an empty database (true/false).
FORGE_DEMO_DATA=false

# Optional: e-mail for password resets, the daily check-up and new-device alerts.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=forge@example.com
# SMTP_PASSWORD=
# SMTP_FROM=forge@example.com

# Optional: reverse-proxy addresses allowed to set X-Forwarded-For.
# TRUSTED_PROXIES=10.0.0.2

# Optional monitoring sources (reachable from the server, e.g. over a VPN).
# VICTORIAMETRICS_URL=http://metrics.internal:8428
# GRAFANA_URL=http://grafana.internal:3000
# GRAFANA_PUBLIC_URL=https://grafana.example.com
